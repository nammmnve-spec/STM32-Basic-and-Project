--cpu Cortex-M0
"mpu6050\startup_stm32f030x6.o"
"mpu6050\stm32f0xx_hal_i2c.o"
"mpu6050\stm32f0xx_hal_i2c_ex.o"
"mpu6050\stm32f0xx_hal_rcc.o"
"mpu6050\stm32f0xx_hal_rcc_ex.o"
"mpu6050\stm32f0xx_hal.o"
"mpu6050\stm32f0xx_hal_gpio.o"
"mpu6050\stm32f0xx_hal_dma.o"
"mpu6050\stm32f0xx_hal_cortex.o"
"mpu6050\stm32f0xx_hal_pwr.o"
"mpu6050\stm32f0xx_hal_pwr_ex.o"
"mpu6050\stm32f0xx_hal_flash.o"
"mpu6050\stm32f0xx_hal_flash_ex.o"
