--cpu Cortex-M3
"i2cslave\startup_stm32f103xb.o"
"i2cslave\main.o"
"i2cslave\stm32f1xx_it.o"
"i2cslave\stm32f1xx_hal_msp.o"
"i2cslave\stm32f1xx_hal_gpio_ex.o"
"i2cslave\stm32f1xx_hal_i2c.o"
"i2cslave\stm32f1xx_hal.o"
"i2cslave\stm32f1xx_hal_rcc.o"
"i2cslave\stm32f1xx_hal_rcc_ex.o"
"i2cslave\stm32f1xx_hal_gpio.o"
"i2cslave\stm32f1xx_hal_dma.o"
"i2cslave\stm32f1xx_hal_cortex.o"
"i2cslave\stm32f1xx_hal_pwr.o"
"i2cslave\stm32f1xx_hal_flash.o"
"i2cslave\stm32f1xx_hal_flash_ex.o"
"i2cslave\stm32f1xx_hal_exti.o"
"i2cslave\system_stm32f1xx.o"
--strict --scatter "i2cslave\i2cslave.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "i2cslave.map" -o i2cslave\i2cslave.axf