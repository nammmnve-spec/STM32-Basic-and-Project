--cpu Cortex-M3
"i2cmaster\startup_stm32f103xb.o"
"i2cmaster\main.o"
"i2cmaster\stm32f1xx_it.o"
"i2cmaster\stm32f1xx_hal_msp.o"
"i2cmaster\stm32f1xx_hal_gpio_ex.o"
"i2cmaster\stm32f1xx_hal_i2c.o"
"i2cmaster\stm32f1xx_hal.o"
"i2cmaster\stm32f1xx_hal_rcc.o"
"i2cmaster\stm32f1xx_hal_rcc_ex.o"
"i2cmaster\stm32f1xx_hal_gpio.o"
"i2cmaster\stm32f1xx_hal_dma.o"
"i2cmaster\stm32f1xx_hal_cortex.o"
"i2cmaster\stm32f1xx_hal_pwr.o"
"i2cmaster\stm32f1xx_hal_flash.o"
"i2cmaster\stm32f1xx_hal_flash_ex.o"
"i2cmaster\stm32f1xx_hal_exti.o"
"i2cmaster\system_stm32f1xx.o"
--strict --scatter "i2cmaster\i2cmaster.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "i2cmaster.map" -o i2cmaster\i2cmaster.axf